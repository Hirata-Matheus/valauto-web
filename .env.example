# Supabase — deixe em branco para rodar com o repositorio em memoria (dados de seed).
# Com as duas primeiras variaveis preenchidas o app passa a usar o Postgres do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas em rotas de servidor (moderacao/admin). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Base usada nos links de verificacao de e-mail e no sitemap/metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — deixe em branco para rodar com o repositorio em memoria (dados de seed).
# Com URL + chave preenchidas o app passa a usar o Postgres do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Chave publica (Project Settings -> API Keys -> Publishable key, "sb_publishable_...").
# A "anon key" JWT legada tambem funciona em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reservada para rotas de servidor de moderacao/admin (Fase 3) — a Fase 1 nao usa.
# Nunca exponha no client nem prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base usada nos links de verificacao de e-mail e no sitemap/metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
